---
import Base from '../layouts/Base.astro';
import ListaPosts from '../components/ListaPosts.astro';
import { postsPublicados } from '../lib/util';

const posts = await postsPublicados();
---
<Base titulo="Arquivo">
  <section class="hero">
    <span class="kicker">Arquivo</span>
    <h1>Tudo o que já saiu.</h1>
    <p class="mono">{posts.length} posts, do mais recente ao mais antigo.</p>
  </section>
  <ListaPosts posts={posts} />
</Base>
