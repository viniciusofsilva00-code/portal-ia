---
import Base from '../layouts/Base.astro';
import { url } from '../lib/util';
---
<Base titulo="Busca">
  <link slot="head" rel="stylesheet" href={url('pagefind/pagefind-ui.css')} />
  <h1>Busca</h1>
  <div id="busca"></div>
  <noscript>A busca precisa de JavaScript.</noscript>
  <script is:inline define:vars={{ bundle: url('pagefind/') }}>
    const s = document.createElement('script');
    s.src = bundle + 'pagefind-ui.js';
    s.onload = () => {
      new PagefindUI({
        element: '#busca',
        bundlePath: bundle,
        showSubResults: false,
        showImages: false,
        translations: { placeholder: 'Buscar posts', zero_results: 'Nada encontrado para [SEARCH_TERM]' },
      });
      const q = new URLSearchParams(location.search).get('q');
      if (q) setTimeout(() => { const i = document.querySelector('#busca input'); if (i) { i.value = q; i.dispatchEvent(new Event('input')); } }, 50);
    };
    document.head.appendChild(s);
  </script>
  <style is:global>
    #busca { --pagefind-ui-primary: var(--accent); --pagefind-ui-text: var(--fg); --pagefind-ui-background: var(--bg); --pagefind-ui-border: var(--line); --pagefind-ui-tag: var(--tag-bg); --pagefind-ui-font: inherit; }
  </style>
</Base>
