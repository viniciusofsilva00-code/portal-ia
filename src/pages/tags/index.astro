---
import Base from '../../layouts/Base.astro';
import { postsPublicados, todasTags, url } from '../../lib/util';

const tags = [...todasTags(await postsPublicados()).entries()].sort((a, b) =>
  b[1].posts.length - a[1].posts.length || a[1].nome.localeCompare(b[1].nome, 'pt-BR'),
);
---
<Base titulo="Tags">
  <section class="hero">
    <span class="kicker">Tags</span>
    <h1>Navegue por assunto.</h1>
    <p class="mono">{tags.length} tags</p>
  </section>
  {tags.length === 0 ? <p class="vazio">// nenhuma tag ainda</p> : (
    <ul class="tags">
      {tags.map(([slug, t]) => (
        <li><a href={url(`tags/${slug}/`)}>{t.nome}<span class="n">{t.posts.length}</span></a></li>
      ))}
    </ul>
  )}
</Base>
