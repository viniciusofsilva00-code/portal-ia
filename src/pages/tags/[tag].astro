---
import Base from '../../layouts/Base.astro';
import ListaPosts from '../../components/ListaPosts.astro';
import { postsPublicados, todasTags, url, type Post } from '../../lib/util';

export async function getStaticPaths() {
  const mapa = todasTags(await postsPublicados());
  return [...mapa.entries()].map(([tag, t]) => ({ params: { tag }, props: t }));
}
const { nome, posts } = Astro.props as { nome: string; posts: Post[] };
---
<Base titulo={`Tag: ${nome}`}>
  <section class="hero">
    <a class="kicker" href={url('tags/')} style="text-decoration:none">Todas as tags</a>
    <h1>#{nome}</h1>
    <p class="mono">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
  </section>
  <ListaPosts posts={posts} />
</Base>
