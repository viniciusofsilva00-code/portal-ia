---
import { dataCurta, url, type Post } from '../lib/util';

interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
---
<ul class="lista">
  {posts.map((p) => (
    <li class="item">
      <time class="quando" datetime={p.data.data.toISOString()}>{dataCurta(p.data.data)}</time>
      <div>
        <h3><a href={url(`posts/${p.id}/`)}>{p.data.titulo}</a></h3>
        {p.data.resumo && <p>{p.data.resumo}</p>}
      </div>
    </li>
  ))}
</ul>
