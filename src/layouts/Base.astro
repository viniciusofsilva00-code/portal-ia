---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { SITE_TITULO, SITE_DESCRICAO, url } from '../lib/util';

interface Props {
  titulo?: string;
  descricao?: string;
}
const { titulo, descricao = SITE_DESCRICAO } = Astro.props;
const tituloCompleto = titulo ? `${titulo} — ${SITE_TITULO}` : SITE_TITULO;
const canonical = new URL(Astro.url.pathname, Astro.site);
const caminho = Astro.url.pathname;
const inicio = url('');
const nav = [
  { href: inicio, rotulo: 'cd ~', aria: 'Início', classe: 'cmd' },
  { href: url('arquivo/'), rotulo: 'Arquivo' },
  { href: url('tags/'), rotulo: 'Tags' },
  { href: url('busca/'), rotulo: 'Busca' },
  { href: url('rss.xml'), rotulo: 'RSS' },
];
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <meta name="theme-color" content="#0a0a0a" />
    <script is:inline>try{var t=localStorage.getItem("vl_tema");if(t==="light"||t==="dark")document.documentElement.dataset.theme=t}catch(e){}</script>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITULO} href={url('rss.xml')} />
    <link rel="icon" href={url('favicon.ico')} sizes="32x32" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
    />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:type" content="website" />
    <slot name="head" />
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="marca" href={url()} aria-label={`${SITE_TITULO} — início`}>
          <Logo />
        </a>
        <nav aria-label="Principal">
          {nav.map((n) => (
            <a href={n.href} class={n.classe} aria-label={n.aria} title={n.aria} aria-current={(n.href === inicio ? caminho.replace(/\/$/, '') === inicio.replace(/\/$/, '') : caminho.startsWith(n.href)) ? 'page' : undefined}>{n.rotulo}</a>
          ))}
        </nav>
        <button type="button" class="tema" id="tema" aria-label="Usar tema escuro" title="Usar tema escuro">☾ escuro</button>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <a class="endosso" href={url()}>
          <img src={url('endosso-portal_ia.svg?v=2')} alt="portal_ia · um projeto vini_lab" width="276" height="32" loading="lazy" />
        </a>
        <span>
          Curadoria automática revisada por regras editoriais. Cada post resume e analisa notícias
          publicadas por terceiros; o conteúdo original pertence às fontes citadas.
        </span>
        <span class="mono">// atualizado todo dia às 08:00 BRT · <a href={url('rss.xml')}>rss</a></span>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var b = document.getElementById('tema');
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        var salvo = function () { try { var t = localStorage.getItem('vl_tema'); return t === 'light' || t === 'dark' ? t : null; } catch (e) { return null; } };
        var atual = function () { return document.documentElement.dataset.theme || (mq.matches ? 'dark' : 'light'); };
        var pintar = function () {
          var escuro = atual() === 'dark';
          b.textContent = escuro ? '☀ claro' : '☾ escuro';
          var r = escuro ? 'Usar tema claro' : 'Usar tema escuro';
          b.setAttribute('aria-label', r); b.title = r;
        };
        b.addEventListener('click', function () {
          var novo = atual() === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = novo;
          try { localStorage.setItem('vl_tema', novo); } catch (e) {}
          pintar();
        });
        var seguir = function () { if (!salvo()) { delete document.documentElement.dataset.theme; pintar(); } };
        if (mq.addEventListener) mq.addEventListener('change', seguir); else if (mq.addListener) mq.addListener(seguir);
        pintar();
      })();
    </script>
  </body>
</html>
